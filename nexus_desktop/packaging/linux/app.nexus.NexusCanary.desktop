# SPDX-License-Identifier: Nebula
[Desktop Entry]
Name=NEXUS Canary
GenericName=Instant Messenger
Comment=Canary build of NEXUS
Exec=app.nexus.NEXUSCanary %U
TryExec=app.nexus.NEXUSCanary
Icon=app.nexus.NEXUSCanary
Type=Application
Categories=Network;InstantMessaging;Chat;
Keywords=chat;im;messaging;messenger;voip;voice;video;call;
StartupWMClass=app.nexus.NEXUSCanary
SingleMainWindow=true
StartupNotify=true
MimeType=x-scheme-handler/nexus;
Terminal=false
X-GNOME-UsesNotifications=true
Actions=open-settings;new-dm;

[Desktop Action open-settings]
Name=Open Settings
Exec=app.nexus.NEXUSCanary --nexus-task=open-settings %U

[Desktop Action new-dm]
Name=New Direct Message
Exec=app.nexus.NEXUSCanary --nexus-task=new-dm %U
