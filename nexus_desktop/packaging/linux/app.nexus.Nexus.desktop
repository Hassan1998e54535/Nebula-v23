# SPDX-License-Identifier: Nebula
[Desktop Entry]
Name=NEXUS
GenericName=Instant Messenger
Comment=Instant messaging and VoIP
Exec=app.nexus.NEXUS %U
TryExec=app.nexus.NEXUS
Icon=app.nexus.NEXUS
Type=Application
Categories=Network;InstantMessaging;Chat;
Keywords=chat;im;messaging;messenger;voip;voice;video;call;
StartupWMClass=app.nexus.NEXUS
SingleMainWindow=true
StartupNotify=true
MimeType=x-scheme-handler/nexus;
Terminal=false
X-GNOME-UsesNotifications=true
Actions=open-settings;new-dm;

[Desktop Action open-settings]
Name=Open Settings
Exec=app.nexus.NEXUS --nexus-task=open-settings %U

[Desktop Action new-dm]
Name=New Direct Message
Exec=app.nexus.NEXUS --nexus-task=new-dm %U
