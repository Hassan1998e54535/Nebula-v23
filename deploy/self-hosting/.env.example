# Every variable docker-compose.yml reads. A value an install must set is
# uncommented. A commented line shows the default, or an example where its comment
# says so, and nothing after = means the service decides. An empty value keeps the
# default too. Compose expands top to bottom, so a line using ${...} must sit below
# every name it reads.

NEXUS_DOMAIN=chat.example.com
NEXUS_PUBLIC_SCHEME=https
NEXUS_PUBLIC_PORT=443

# The address browsers use. NEXUS_HTTP_PORT and NEXUS_HTTPS_PORT below decide
# which host ports NEXUS binds.

# By default NEXUS binds 80 and 443 and gets its own certificate. Point DNS here.
# Behind your own reverse proxy, uncomment this instead: NEXUS then serves plain
# HTTP on 127.0.0.1:8080. Keep the scheme and port above describing the public
# address, not this one.
#COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml

# Where that plain-HTTP port binds. Use 0.0.0.0:8080 only when the proxy is on
# another machine, and firewall it to that machine.
#NEXUS_EDGE_BIND=127.0.0.1:8080

# Which hops may set X-Forwarded-For. The default covers private and loopback
# addresses. Set your proxy's address if it reaches NEXUS from a public IP.
#NEXUS_EDGE_TRUSTED_PROXIES=private_ranges

# The origin browsers see, no trailing slash. Set it when browsers reach the
# instance on a host NEXUS_DOMAIN does not name, and it wins over the three
# values above. Scheme, host and optional port only. It does not move the
# published ports.
#NEXUS_PUBLIC_ORIGIN=https://chat.example.com

# The address the edge listens on inside its container. Both proxy overlays set
# this themselves, so a value here is ignored under either. Include the scheme.
#NEXUS_EDGE_SITE_ADDRESS=https://chat.example.com

# The old name for the line above, read only when it is unset.
#NEXUS_CADDY_SITE_ADDRESS=

# Host ports. Container 80 handles the redirect and the certificate challenge,
# container 443 the TLS site. NEXUS_HTTPS_PORT moves TCP and UDP together, since
# HTTP/3 needs both. Both accept a bind address. Give them different host ports.
#NEXUS_HTTP_PORT=80
#NEXUS_HTTPS_PORT=443
#NEXUS_HTTP_PORT=127.0.0.1:80
#NEXUS_HTTPS_PORT=127.0.0.1:443

# HTTPS on 8443. Host 80 stays published for the certificate challenge, which
# only ever arrives on public 80 or 443. Serve your own certificate if nothing
# forwards those.
#NEXUS_PUBLIC_PORT=8443
#NEXUS_HTTPS_PORT=8443

# Plain HTTP on 19080. Nothing binds host 80, and the last line parks the idle
# 443 publish on loopback.
#NEXUS_PUBLIC_SCHEME=http
#NEXUS_PUBLIC_PORT=19080
#NEXUS_HTTP_PORT=19080
#NEXUS_HTTPS_PORT=127.0.0.1:443

# A tunnel needs no HTTPS publish. tunnel.compose.yml ships beside this file and
# leaves one loopback HTTP publish. Needs Compose 2.24.4 or newer.
#COMPOSE_FILE=docker-compose.yml:tunnel.compose.yml

NEXUS_REGISTRY_OWNER=hasoon7
NEXUS_REGISTRY=ghcr.io/${NEXUS_REGISTRY_OWNER}
NEXUS_IMAGE_TAG=v1

POSTGRES_PASSWORD=CHANGE_ME
MEILI_MASTER_KEY=CHANGE_ME
# Set these to run Postgres or the object store outside the stack. Backing up a
# store you moved out is yours to arrange. An upgrade dumps the bundled postgres
# service and skips the dump only when the stack defines none. The values below
# are examples.
#NEXUS_POSTGRES_HOST=db.example.com
#NEXUS_POSTGRES_PORT=5432
#NEXUS_POSTGRES_DATABASE=nexus
#NEXUS_POSTGRES_USERNAME=nexus
#NEXUS_POSTGRES_SSL=true
#NEXUS_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
#NEXUS_S3_PUBLIC_ENDPOINT=https://cdn.example.com
#NEXUS_S3_REGION=eu-central-1
#NEXUS_S3_FORCE_PATH_STYLE=false

# Bucket names. The bundled store creates these. An outside store needs them to
# exist already.
#NEXUS_S3_BUCKET_CDN=nexus
#NEXUS_S3_BUCKET_UPLOADS=nexus-uploads
#NEXUS_S3_BUCKET_REPORTS=nexus-reports
#NEXUS_S3_BUCKET_HARVESTS=nexus-harvests
# With the object store outside the stack, add this overlay to COMPOSE_FILE and
# the bundled seaweedfs no longer starts. Put it after any other overlay, such as
# docker-compose.yml:docker-compose.proxy.yml:external-object-store.compose.yml.
# Needs Compose 2.24.4 or newer.
#COMPOSE_FILE=docker-compose.yml:external-object-store.compose.yml

# A full connection URL wins over the host, port and database above. The URL is an
# example. The CA is the PEM text of the certificate, with \n for line breaks.
#NEXUS_POSTGRES_URL=postgres://nexus:secret@db.example.com:5432/nexus
#NEXUS_POSTGRES_SSL_CA=
# The Postgres table that holds the key-value store.
#NEXUS_POSTGRES_KV_TABLE=nexus_kv
# media-proxy reads through these when the store serves reads from another
# address or bucket.
#NEXUS_S3_READ_ENDPOINT=
#NEXUS_S3_READ_BUCKET=
#NEXUS_S3_READ_BUCKET_STYLE=
# A temporary S3 session token, read by media-proxy only.
#NEXUS_S3_SESSION_TOKEN=
# The bundled store refuses unsigned reads. Set false only for a public-read bucket.
#NEXUS_S3_READ_SIGNED=true

# The other bundled services, pointed elsewhere. Removing a service from the
# stack belongs in an override file, since an upgrade replaces docker-compose.yml.
# The URLs below are examples.
#NEXUS_KV_URL=redis://cache.example.com:6379/0
#NEXUS_NATS_URL=nats://mq.example.com:4222
#NEXUS_NATS_JETSTREAM_URL=nats://mq.example.com:4222
#NEXUS_SVC_NATS_URL=nats://mq.example.com:4222
#NEXUS_SEARCH_URL=https://search.example.com
#NEXUS_LIVEKIT_INTERNAL_URL=http://livekit.example.com:7880
# How the stack talks to those services.
#NEXUS_KV_MODE=standalone
#NEXUS_SEARCH_ENGINE=meilisearch
#NEXUS_SEARCH_USERNAME=
#NEXUS_SEARCH_PASSWORD=
#NEXUS_SEARCH_TLS_REJECT_UNAUTHORIZED=true

# Voice off. The livekit service still runs until an override removes it.
#NEXUS_LIVEKIT_ENABLED=false

# Optional systems, each off unless configured.
#NEXUS_STRIPE_ENABLED=false
#NEXUS_STRIPE_SECRET_KEY=
#NEXUS_STRIPE_WEBHOOK_SECRET=
# Stripe prices as one JSON object. The admin dashboard can set them instead.
#NEXUS_STRIPE_PRICES={}
#NEXUS_STRIPE_LEGACY_PRICES={}
#NEXUS_API_DONATION_PROXY_KEY=
#NEXUS_API_TRUSTED_CALLERS=[]
#NEXUS_VISIONARIES_GUILD_ID=
#NEXUS_VISIONARIES_GUILD_VISIONARY_ROLE_ID=

# Upload virus scanning, off by default. No ClamAV container ships, so point
# this at your own. The values below are examples.
#NEXUS_CLAMAV_ENABLED=true
#NEXUS_CLAMAV_HOST=clamav
#NEXUS_CLAMAV_PORT=3310
#NEXUS_CLAMAV_FAIL_OPEN=false

# Outside lookups, off unless turned on. The breached password check asks
# api.pwnedpasswords.com.
#NEXUS_BREACHED_PASSWORD_CHECK_ENABLED=false
#NEXUS_BLOCKLIST_FEEDS_ENABLED=false
# A local path, or an s3:// URL read with the S3 credentials of this file.
#NEXUS_GEOIP_DB_PATH=

# The client address. The edge sets X-Forwarded-For on every hop, so keep the
# trust on and the default header. Turning the trust off makes the api ignore
# the header and use the connection's peer address, which here is the edge.
#NEXUS_CLIENT_IP_HEADER_NAME=x-forwarded-for
#NEXUS_TRUST_CLIENT_IP_HEADER=true

# How much the services write. LOG_LEVEL covers the api and worker and takes trace,
# debug, info, warn, error or fatal. RUST_LOG covers the Rust services and takes
# an EnvFilter such as debug. The gateway takes an Erlang level such as notice,
# and LOGGER_LEVEL beats NEXUS_GATEWAY_LOGGER_LEVEL.
#LOG_LEVEL=info
#RUST_LOG=info
#NEXUS_GATEWAY_LOGGER_LEVEL=info
#LOGGER_LEVEL=

NEXUS_S3_ACCESS_KEY=nexus
NEXUS_S3_SECRET_KEY=CHANGE_ME

NEXUS_SUDO_MODE_SECRET=CHANGE_ME
NEXUS_CONNECTION_INITIATION_SECRET=CHANGE_ME
NEXUS_PROFILE_PSEUDONYM_SECRET=CHANGE_ME
NEXUS_GATEWAY_RPC_AUTH_TOKEN=CHANGE_ME
NEXUS_ERLANG_COOKIE=CHANGE_ME
NEXUS_MEDIA_PROXY_SECRET_KEY=CHANGE_ME
NEXUS_MEDIA_PROXY_UPLOAD_RELAY_SECRET_BASE64=CHANGE_ME
NEXUS_ADMIN_SECRET_KEY_BASE=CHANGE_ME
NEXUS_ADMIN_OAUTH_CLIENT_SECRET=CHANGE_ME

# The token every service sends to NATS. The bundled NATS needs none, so this
# stays empty unless an override points at an external one.
#NEXUS_NATS_AUTH_TOKEN=

NEXUS_VAPID_PUBLIC_KEY=CHANGE_ME
NEXUS_VAPID_PRIVATE_KEY=CHANGE_ME

# Defaults to admin@ followed by NEXUS_DOMAIN. Set it if that mailbox does not
# exist.
#NEXUS_VAPID_EMAIL=admin@chat.example.com

# The passkey RP ID defaults to NEXUS_DOMAIN, whatever NEXUS_PUBLIC_ORIGIN says.
# Changing the RP ID invalidates every passkey registered against the old value.
#NEXUS_PASSKEY_RP_ID=chat.example.com
#NEXUS_PASSKEY_RP_NAME=NEXUS
#NEXUS_PASSKEY_ADDITIONAL_ALLOWED_ORIGINS=https://chat.example.com
#NEXUS_PASSKEY_ADDITIONAL_ALLOWED_ORIGINS=http://chat.example.com:19080

# Notification jobs the push container holds at once, 1 to 1000000.
#NEXUS_PUSH_SERVICE_QUEUE_CAPACITY=10000
# Provider requests the push container sends at once, 1 to 65536.
#NEXUS_PUSH_SERVICE_SEND_CONCURRENCY=256
# The push container's provider addresses and relay hosts.
#NEXUS_PUSH_SERVICE_APNS_BASE_URL=
#NEXUS_PUSH_SERVICE_FCM_BASE_URL=https://fcm.googleapis.com
#NEXUS_PUSH_SERVICE_MANAGED_RELAY_HOSTS=push.nexus.com
#NEXUS_PUSH_SERVICE_OWN_RELAY_HOSTS=
# Push hosts on your own network, such as a ntfy server, that may resolve to
# private addresses. Comma separated.
#NEXUS_PUSH_SERVICE_PRIVATE_HOSTS=ntfy.example.com
#NEXUS_PUSH_SERVICE_RELAY_CONSENT_ACCEPTED=false

# Direct mobile push through your own APNs and FCM credentials, off by default.
#NEXUS_PUSH_APNS_ENABLED=false
#NEXUS_PUSH_APNS_TEAM_ID=
#NEXUS_PUSH_APNS_KEY_ID=
#NEXUS_PUSH_APNS_PRIVATE_KEY=
#NEXUS_PUSH_APNS_PRIVATE_KEY_PATH=
#NEXUS_PUSH_APNS_APPS=
#NEXUS_PUSH_APNS_DEFAULT_ENVIRONMENT=production
#NEXUS_PUSH_FCM_ENABLED=false
#NEXUS_PUSH_FCM_PROJECT_ID=
#NEXUS_PUSH_FCM_CLIENT_EMAIL=
#NEXUS_PUSH_FCM_PRIVATE_KEY=
#NEXUS_PUSH_FCM_PRIVATE_KEY_PATH=
#NEXUS_PUSH_FCM_SERVICE_ACCOUNT_JSON_PATH=
#NEXUS_PUSH_FCM_TOKEN_URI=https://oauth2.googleapis.com/token
#NEXUS_PUSH_FCM_APPS=


# Optional media policies, both off by default. See the operator docs.
#
# CORS limits which web origins may read media. A request with no Origin, or
# from the desktop app, is always served.
#
# Signatures make an attachment read need a signed URL, so a copied link stops
# working. Needs a secret from openssl rand -base64 32, first entry signs and
# every entry verifies.
#
# Each mode is off, report or enforce, and off is the default. Start at report.
# media-proxy reads these at start, so apply with docker compose up -d
# media-proxy. The values below are examples.
#NEXUS_MEDIA_PROXY_CORS_MODE=enforce
#NEXUS_MEDIA_PROXY_CORS_ALLOWED_ORIGINS=https://chat.example.com
#NEXUS_MEDIA_PROXY_ATTACHMENT_URL_SECRETS_BASE64=
#NEXUS_MEDIA_PROXY_ATTACHMENT_SIGNATURE_MODE=enforce

# Extra Content-Security-Policy sources, appended to the built-in ones. Set one
# only when a browser must reach an origin the defaults do not cover. Separate
# several with spaces or commas. The three values below are illustrations.
#NEXUS_CSP_EXTRA_DEFAULT_SRC=
#NEXUS_CSP_EXTRA_CONNECT_SRC=wss://livekit.example.com
#NEXUS_CSP_EXTRA_IMG_SRC=https://cdn.example.com
#NEXUS_CSP_EXTRA_MEDIA_SRC=
#NEXUS_CSP_EXTRA_FONT_SRC=
#NEXUS_CSP_EXTRA_SCRIPT_SRC=https://analytics.example.com
#NEXUS_CSP_EXTRA_STYLE_SRC=
#NEXUS_CSP_EXTRA_FRAME_SRC=
#NEXUS_CSP_EXTRA_WORKER_SRC=
#NEXUS_CSP_EXTRA_MANIFEST_SRC=

# One report-uri for CSP violation reports. Empty leaves the directive off.
#NEXUS_CSP_REPORT_URI=

# Let the SSO provider resolve to a private address. Off by default, so a
# misconfigured provider URL cannot reach internal services. Turn it on only for
# a provider on your own network. The value below is an example.
#NEXUS_SSO_ALLOW_PRIVATE_ADDRESSES=true

# These reach both LiveKit and the api. Change them together.
LIVEKIT_API_KEY=nexus
LIVEKIT_API_SECRET=CHANGE_ME

# The URL browsers use for voice signalling. Built from the public origin plus
# /livekit. Set it only when LiveKit is served from another host.
#NEXUS_LIVEKIT_URL=

# Media ports. LiveKit advertises these, so forward the same numbers.
#NEXUS_LIVEKIT_TCP_PORT=7881
#NEXUS_LIVEKIT_UDP_PORT=7882

# LiveKit finds its public address over STUN. A host that cannot reach one stops
# with "could not resolve external IP", so set the address by hand instead, or
# point STUN elsewhere. The values below are examples.
#NEXUS_LIVEKIT_USE_EXTERNAL_IP=false
#NEXUS_LIVEKIT_NODE_IP=203.0.113.10
#NEXUS_LIVEKIT_STUN_PRIMARY=stun.l.google.com:19302
#NEXUS_LIVEKIT_STUN_SECONDARY=stun1.l.google.com:19302

# The voice region users see, and how much LiveKit logs.
#NEXUS_LIVEKIT_DEFAULT_REGION={"id":"default","name":"Default","emoji":"🌍","latitude":0,"longitude":0}
#NEXUS_LIVEKIT_LOG_LEVEL=info

# STUN servers for peer-to-peer calls, which need the voice_p2p experiment turned
# on in the admin panel. STUN finds each peer's public address. The value below
# is an example.
#NEXUS_VOICE_P2P_STUN_URLS=stun:stun.example.com:3478

NEXUS_KLIPY_API_KEY=
#NEXUS_YOUTUBE_API_KEY=
# Hosts the api never unfurls, comma separated.
#NEXUS_API_UNFURL_IGNORED_HOSTS=

# Email delivery. Only an instance where members sign in with email needs it.
NEXUS_EMAIL_ENABLED=false
NEXUS_EMAIL_PROVIDER=none
NEXUS_EMAIL_FROM_EMAIL=noreply@example.com
NEXUS_EMAIL_FROM_NAME=
#NEXUS_EMAIL_REPLY_TO_EMAIL=support@example.com
NEXUS_EMAIL_APP_BASE_URL=
NEXUS_EMAIL_SMTP_HOST=
NEXUS_EMAIL_SMTP_PORT=587
NEXUS_EMAIL_SMTP_USERNAME=
NEXUS_EMAIL_SMTP_PASSWORD=
# How the SMTP connection is encrypted: implicit, starttls, opportunistic or
# none. Leave it empty for implicit TLS on port 465 and required STARTTLS on any
# other port.
NEXUS_EMAIL_SMTP_TLS_MODE=
# The older switch, read only while the mode above is empty. true is implicit
# and false is opportunistic.
#NEXUS_EMAIL_SMTP_SECURE=false
#NEXUS_EMAIL_WEBHOOK_SECRET=

NEXUS_DISCOVERY_ENABLED=true
#NEXUS_DISCOVERY_MIN_MEMBER_COUNT=1

# Instance identity and account policy. The terms, privacy and community
# guidelines links have no variable here. Set them in the admin panel under
# Instance Config. Until a guidelines link is set, the clients, report forms and
# enforcement emails show none.
#NEXUS_APP_PRODUCT_NAME=NEXUS
#NEXUS_APP_ICON_URL=
#NEXUS_APP_SYMBOL_URL=
#NEXUS_APP_LOGO_URL=
#NEXUS_APP_WORDMARK_URL=
#NEXUS_APP_FAVICON_URL=
#NEXUS_APP_THEME_COLOR=
#NEXUS_APP_STATUS_PAGE_URL=
#NEXUS_APP_STATUS_PAGE_INCIDENT_HISTORY_URL=
#NEXUS_INSTANCE_SETUP_CONFIGURED=false
# Setup token the wizard asks for before the first admin account. 32 to 256 characters. Unset means the API generates one on the first start and writes it to its log once.
#NEXUS_SETUP_TOKEN=
# How members sign in on a new instance, username or email. Unset means username. Read only on the first start.
#NEXUS_ACCOUNT_IDENTITY=
# Username tags on a new email instance. none gives unique names with no tag, random gives name#4821. Unset means none. A username instance always uses none. Read only on the first start.
#NEXUS_TAG_STYLE=
#NEXUS_AUTO_JOIN_INVITE_CODE=
#NEXUS_DELETION_GRACE_PERIOD_HOURS=336

# Report retention. A daily job deletes each report this many days after it was
# filed, with its evidence copies and search entry, unless a legal hold is set.
#NEXUS_REPORT_RETENTION_DAYS=365
# Delete resolved reports this many days after they were resolved, when that
# comes first. Unset leaves them to NEXUS_REPORT_RETENTION_DAYS.
#NEXUS_RESOLVED_REPORT_RETENTION_DAYS=
# true only logs what the job would delete. Deleted evidence cannot be
# restored, so check the "Processed report retention" log line of the worker
# in a dry run first if you are unsure.
#NEXUS_REPORT_RETENTION_DRY_RUN=false

# Sign in with Bluesky, off unless turned on.
#NEXUS_AUTH_BLUESKY_ENABLED=false
#NEXUS_AUTH_BLUESKY_CLIENT_NAME=NEXUS
#NEXUS_AUTH_BLUESKY_CLIENT_URI=
#NEXUS_AUTH_BLUESKY_LOGO_URI=
#NEXUS_AUTH_BLUESKY_TOS_URI=
#NEXUS_AUTH_BLUESKY_POLICY_URI=
#NEXUS_AUTH_BLUESKY_KEYS=

# Public addresses. Each follows the public origin unless set here.
#NEXUS_API_ENDPOINT=
#NEXUS_API_CLIENT_ENDPOINT=
#NEXUS_APP_ENDPOINT=
#NEXUS_GATEWAY_ENDPOINT=
#NEXUS_MEDIA_ENDPOINT=
#NEXUS_STATIC_CDN_ENDPOINT=
#NEXUS_ADMIN_ENDPOINT=
#NEXUS_MARKETING_ENDPOINT=
#NEXUS_INVITE_ENDPOINT=
#NEXUS_GIFT_ENDPOINT=
#NEXUS_MEDIA_PROXY_UPLOAD_RELAY_ENDPOINT=
# This follows NEXUS_STATIC_CDN_ENDPOINT first, then the public origin.
#NEXUS_GATEWAY_STATIC_CDN_ENDPOINT=
# These follow NEXUS_MEDIA_ENDPOINT first, then the public origin.
#NEXUS_MEDIA_PROXY_PUBLIC_ENDPOINT=
#NEXUS_GATEWAY_MEDIA_PROXY_ENDPOINT=

# Extra hosts for static assets, invites, gifts and the web app. Empty by default.
#NEXUS_STATIC_CDN_DOMAIN=
#NEXUS_INVITE_DOMAIN=
#NEXUS_GIFT_DOMAIN=
#NEXUS_APP_ORIGIN_ALIASES=

# The path the admin panel is served under. The edge and the admin service read
# it. The api follows it through the default NEXUS_ADMIN_ENDPOINT, and not when
# NEXUS_ADMIN_ENDPOINT is set. Write it with a leading slash and no trailing
# slash.
#NEXUS_ADMIN_BASE_PATH=/admin

# The compression the edge offers, as Caddy encode arguments.
#NEXUS_EDGE_ENCODE=zstd gzip

# Extra Caddy global options, one line, added to the global block of the edge
# Caddyfile. Empty adds nothing. Example: email admin@chat.example.com
#NEXUS_EDGE_GLOBAL_OPTIONS=

# Images of the bundled services, for a mirror or another tag. A new Postgres
# major needs a dump and restore, as the upgrade guide describes.
#NEXUS_CADDY_IMAGE=caddy:2.11-alpine
#NEXUS_POSTGRES_IMAGE=postgres:16-alpine
#NEXUS_VALKEY_IMAGE=valkey/valkey:9.1-alpine
#NEXUS_NATS_IMAGE=nats:2.14-alpine
#NEXUS_MEILISEARCH_IMAGE=getmeili/meilisearch:v1.53
#NEXUS_SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.47
#NEXUS_LIVEKIT_IMAGE=livekit/livekit-server:v1.12.0

# Restart policy for every long-running service.
#NEXUS_RESTART_POLICY=unless-stopped

# Health checks. Raise the retries or start periods on a slow host.
#NEXUS_HEALTHCHECK_INTERVAL=10s
#NEXUS_HEALTHCHECK_TIMEOUT=5s
#NEXUS_HEALTHCHECK_RETRIES=10
#NEXUS_APP_HEALTHCHECK_RETRIES=30
#NEXUS_APP_HEALTHCHECK_START_PERIOD=90s
#NEXUS_SVC_HEALTHCHECK_START_PERIOD=60s
#NEXUS_WORKER_HEALTHCHECK_RETRIES=3
#NEXUS_SEAWEEDFS_HEALTHCHECK_RETRIES=20
#NEXUS_SEAWEEDFS_HEALTHCHECK_START_PERIOD=60s
#NEXUS_SEAWEEDFS_INIT_ATTEMPTS=60

# Container memory. These are ceilings, not allocations, and the defaults suit a
# 16 GB host. The reservations bias the kernel away from reclaiming from services
# whose death takes the instance down. Lower the limits on a smaller host.
#NEXUS_CADDY_MEMORY_LIMIT=256mb
#NEXUS_POSTGRES_MEMORY_LIMIT=5gb
#NEXUS_POSTGRES_MEMORY_RESERVATION=3gb
#NEXUS_VALKEY_MEMORY_LIMIT=256mb
#NEXUS_NATS_MEMORY_LIMIT=256mb
#NEXUS_MEILISEARCH_MEMORY_LIMIT=1536mb
#NEXUS_SEAWEEDFS_MEMORY_LIMIT=2gb
#NEXUS_SEAWEEDFS_INIT_MEMORY_LIMIT=128mb
#NEXUS_LIVEKIT_MEMORY_LIMIT=512mb
#NEXUS_API_MEMORY_LIMIT=2560mb
#NEXUS_API_MEMORY_RESERVATION=1gb
#NEXUS_WORKER_MEMORY_LIMIT=2560mb
#NEXUS_WORKER_MEMORY_RESERVATION=1gb
#NEXUS_GATEWAY_MEMORY_LIMIT=1gb
#NEXUS_GATEWAY_MEMORY_RESERVATION=384mb
#NEXUS_MEDIA_PROXY_MEMORY_LIMIT=512mb
#NEXUS_PUSH_MEMORY_LIMIT=256mb
#NEXUS_STATIC_PROXY_MEMORY_LIMIT=256mb
#NEXUS_APP_PROXY_MEMORY_LIMIT=256mb
#NEXUS_SNOWFLAKES_MEMORY_LIMIT=128mb
#NEXUS_SNOWFLAKES_SHARD_MEMORY_LIMIT=256mb
#NEXUS_USERS_MEMORY_LIMIT=128mb
#NEXUS_USERS_SHARD_MEMORY_LIMIT=256mb
#NEXUS_GIFS_MEMORY_LIMIT=128mb
#NEXUS_GIFS_SHARD_MEMORY_LIMIT=256mb
#NEXUS_MESSAGES_MEMORY_LIMIT=128mb
#NEXUS_MESSAGES_SHARD_MEMORY_LIMIT=256mb
#NEXUS_UNFURL_MEMORY_LIMIT=128mb
#NEXUS_UNFURL_SHARD_MEMORY_LIMIT=256mb
#NEXUS_ADMIN_MEMORY_LIMIT=256mb

# Meilisearch indexing memory and threads. Each indexing thread needs its own
# buffers on top of the indexing memory, so raise the threads only together with
# the container limit above.
#NEXUS_MEILISEARCH_MAX_INDEXING_MEMORY=256mb
#NEXUS_MEILISEARCH_MAX_INDEXING_THREADS=2
#NEXUS_MEILISEARCH_ENV=production
#NEXUS_MEILISEARCH_NO_ANALYTICS=true

# SeaweedFS heap ceiling. Go cannot see the container limit, so without this an
# upload burst gets the container OOM-killed. Keep it near three quarters of
# NEXUS_SEAWEEDFS_MEMORY_LIMIT and raise both together.
#NEXUS_SEAWEEDFS_GOMEMLIMIT=1536MiB
#NEXUS_SEAWEEDFS_TELEMETRY=false

# Volumes SeaweedFS creates at once when a bucket needs space. Each reserves 1 GB
# of free disk from the start, and SeaweedFS's own default of 7 fills a small
# disk before every bucket has one, so uploads fail with no free volumes left.
#NEXUS_SEAWEEDFS_VOLUME_GROWTH=1

# Node sizes its heap from the container limit by default. Leave these unset
# unless you need to pin it. A heap ceiling above the container limit gets the
# container OOM-killed instead of reporting a heap error. The values below are
# examples.
#NEXUS_API_NODE_HEAP_MB=1792
#NEXUS_WORKER_NODE_HEAP_MB=1792

# Extra Node flags for api and worker, appended to NODE_OPTIONS. Empty by
# default. The value below is an example.
#NEXUS_API_NODE_OPTIONS=--heapsnapshot-near-heap-limit=1
#NEXUS_WORKER_NODE_OPTIONS=--heapsnapshot-near-heap-limit=1

# Extra CA certificates api and worker trust, as a PEM bundle path inside the
# container. The default is the image's system bundle.
#NEXUS_NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

# Bundled Postgres tuning. Keep it consistent with the memory limit above. This
# is the server setting, not the per-service pool sizes.
#NEXUS_POSTGRES_SERVER_MAX_CONNECTIONS=150
#NEXUS_POSTGRES_SHARED_BUFFERS=512MB
#NEXUS_POSTGRES_EFFECTIVE_CACHE_SIZE=2GB
#NEXUS_POSTGRES_WORK_MEM=8MB
#NEXUS_POSTGRES_MAINTENANCE_WORK_MEM=256MB
#NEXUS_POSTGRES_AUTOVACUUM_WORK_MEM=128MB
#NEXUS_POSTGRES_SHM_SIZE=1gb
#NEXUS_POSTGRES_RANDOM_PAGE_COST=1.1
#NEXUS_POSTGRES_EFFECTIVE_IO_CONCURRENCY=200
#NEXUS_POSTGRES_DEFAULT_STATISTICS_TARGET=200
#NEXUS_POSTGRES_JIT=off
#NEXUS_POSTGRES_MIN_WAL_SIZE=512MB
#NEXUS_POSTGRES_MAX_WAL_SIZE=2GB
#NEXUS_POSTGRES_CHECKPOINT_COMPLETION_TARGET=0.9
#NEXUS_POSTGRES_WAL_BUFFERS=16MB
#NEXUS_POSTGRES_WAL_COMPRESSION=zstd
#NEXUS_POSTGRES_BGWRITER_DELAY=50ms
#NEXUS_POSTGRES_BGWRITER_LRU_MAXPAGES=1000
#NEXUS_POSTGRES_AUTOVACUUM_VACUUM_SCALE_FACTOR=0.05
#NEXUS_POSTGRES_AUTOVACUUM_ANALYZE_SCALE_FACTOR=0.02
#NEXUS_POSTGRES_AUTOVACUUM_VACUUM_COST_LIMIT=2000
#NEXUS_POSTGRES_TRACK_IO_TIMING=on
#NEXUS_POSTGRES_SHARED_PRELOAD_LIBRARIES=pg_stat_statements

# Postgres pool size of each service that opens a pool.
#NEXUS_API_POSTGRES_MAX_CONNECTIONS=25
#NEXUS_WORKER_POSTGRES_MAX_CONNECTIONS=25
#NEXUS_USERS_SHARD_POSTGRES_MAX_CONNECTIONS=20
#NEXUS_MESSAGES_SHARD_POSTGRES_MAX_CONNECTIONS=20

# The bundled Valkey holds durable state as well as cache, so it runs with an
# append-only file and with noeviction, which fails an over-limit write instead
# of dropping queued work. Change the policy only if that state is kept elsewhere.
#NEXUS_VALKEY_MAXMEMORY=192mb
#NEXUS_VALKEY_MAXMEMORY_POLICY=noeviction
#NEXUS_VALKEY_APPENDFSYNC=everysec

# The gateway derives its scheduler count from the CPU quota, clamped here. One
# scheduler lets a single blocking operation stall every websocket on the node.
#NEXUS_ERLANG_SCHEDULERS_MIN=2
#NEXUS_ERLANG_SCHEDULERS_MAX=16
# A fixed scheduler count skips the clamp. Dirty CPU schedulers default to two
# thirds of it.
#NEXUS_ERLANG_SCHEDULERS=
#NEXUS_ERLANG_DIRTY_CPU_SCHEDULERS=

# Gateway push and RPC tuning.
#NEXUS_GATEWAY_PUSH_ENABLED=true
#NEXUS_GATEWAY_PUSH_ENROLLED_CLEAR_NOTIFICATIONS_ENABLED=true
#NEXUS_GATEWAY_PUSH_OUTBOX_REQUEST_TIMEOUT_MS=100000
#NEXUS_GATEWAY_PRESENCE_PUSH_BUFFER_MAX_ENTRIES=128
#NEXUS_GATEWAY_PRESENCE_PUSH_BUFFER_MAX_BYTES=1048576
#NEXUS_GATEWAY_HTTP_RPC_MAX_CONCURRENCY=512
#NEXUS_GATEWAY_NATS_RPC_MAX_HANDLERS=512
#NEXUS_GATEWAY_HTTP_FAILURE_THRESHOLD=6
#NEXUS_GATEWAY_HTTP_RECOVERY_TIMEOUT_MS=15000

# In-flight request ceiling for every svc router and shard. Unset, each keeps its
# own default: 192 for messages, 320 for snowflakes and 64 for the rest. One value
# replaces all of them, so size it for the busiest. Too low a value rejects
# requests rather than slowing them, and the api turns that into a 503. The value
# below is an example.
#NEXUS_SVC_MAX_CONCURRENT_REQUESTS=320

# svc caches, and how the api calls the svc services over NATS.
#NEXUS_SVC_CACHE_MAX_ENTRIES=100000
#NEXUS_SVC_CACHE_TTL_MS=30000
#NEXUS_GIFS_SHARD_CACHE_MAX_BYTES=536870912
#NEXUS_GIF_SERVICE_NATS_CLIENT_NAME=nexus-api-gifs
#NEXUS_GIF_SERVICE_TIMEOUT_MS=12000
#NEXUS_GIF_SERVICE_REGISTER_SHARE_TIMEOUT_MS=3000
#NEXUS_USERS_SERVICE_NATS_CLIENT_NAME=nexus-api-users
#NEXUS_USERS_SERVICE_TIMEOUT_MS=6000
#NEXUS_USERS_SERVICE_INFLIGHT_MAX_ENTRIES=10000
#NEXUS_SNOWFLAKE_SERVICE_NATS_CLIENT_NAME=nexus-api-snowflakes
#NEXUS_SNOWFLAKE_SERVICE_BATCH_SIZE=128
#NEXUS_SNOWFLAKE_SERVICE_LOW_WATERMARK=
#NEXUS_SNOWFLAKE_SERVICE_MAX_BUFFER_AGE_MS=5000
#NEXUS_SNOWFLAKE_SERVICE_REQUEST_TIMEOUT_MS=6000

# Worker concurrency per lane, as a JSON object keyed by lane.
#NEXUS_API_WORKER_LANE_CONCURRENCY_OVERRIDES=

# Named prepared statements need a session that outlives the transaction, so set
# this to false behind a transaction-pooling connection pooler. The bundled
# compose talks to Postgres directly, where the default is correct.
#NEXUS_POSTGRES_PREPARED_STATEMENTS=true

# How long a client may take to send a request. The header timeout covers the
# request line and headers, the request timeout the whole exchange, and the first
# is clamped down to the second. Milliseconds, 1000 to 3600000.
#NEXUS_API_HEADERS_TIMEOUT_MS=30000
#NEXUS_API_REQUEST_TIMEOUT_MS=120000

# api request limits and IP bans. A refresh interval of 0 stops the periodic
# ban reload.
#NEXUS_API_MAX_INFLIGHT_REQUESTS=512
#NEXUS_API_IP_BAN_EXEMPT_IPS=
#NEXUS_IP_BAN_REFRESH_INTERVAL_MS=300000

# Uploads and data exports. Presigned exports link to NEXUS_S3_PUBLIC_ENDPOINT,
# so turn them on only once browsers can reach it.
#NEXUS_API_PRESIGNED_ATTACHMENT_UPLOADS_ENABLED=true
#NEXUS_API_PRESIGNED_HARVEST_DOWNLOADS_ENABLED=false
#NEXUS_MEDIA_PROXY_UPLOAD_RELAY_MAX_BODY_BYTES=524288000
#NEXUS_MEDIA_PROXY_UPLOAD_RELAY_TOKEN_TTL_SECS=900
#NEXUS_MEDIA_PROXY_UPLOAD_RELAY_KEEP_DIRECT_COUNTRIES=
#NEXUS_API_STORAGE_CHANGE_FEED_ENABLED=false
#NEXUS_API_STORAGE_CHANGE_FEED_STREAM=STORAGE_CHANGES
#NEXUS_API_STORAGE_CHANGE_FEED_SKIP_BUCKETS=
#NEXUS_CACHE_PURGE_ADAPTER=none
#NEXUS_CACHE_PURGE_HTTP_ENDPOINT=
#NEXUS_CACHE_PURGE_HTTP_TOKEN=
#NEXUS_CACHE_PURGE_HTTP_TIMEOUT_MS=10000

# media-proxy limits and timeouts.
#NEXUS_MEDIA_PROXY_READ_ONLY=false
#NEXUS_MEDIA_PROXY_NSFW_THRESHOLD=0.85
#NEXUS_NSFW_SERVICE_ENDPOINT=
#NEXUS_MEDIA_PROXY_MAX_NATIVE_TRANSFORMS=
#NEXUS_MEDIA_PROXY_WORKER_QUEUE_CAPACITY=
#NEXUS_MEDIA_PROXY_MAX_ENCODE_DURATION_MS=30000
#NEXUS_MEDIA_PROXY_MAX_ENCODE_FRAMES=20000
#NEXUS_MEDIA_PROXY_TRANSFORM_TIMEOUT_MS=15000
#NEXUS_MEDIA_PROXY_TRANSFORM_CACHE_BYTES=268435456
#NEXUS_MEDIA_PROXY_TRANSFORM_CACHE_MAX_ENTRY_BYTES=67108864
#NEXUS_MEDIA_PROXY_TRANSFORM_CACHE_TTL_MS=120000
#NEXUS_MEDIA_PROXY_SOCKET_IO_TIMEOUT_MS=30000
#NEXUS_MEDIA_PROXY_SHUTDOWN_GRACE_MS=30000
#NEXUS_MEDIA_PROXY_UPLOAD_RELAY_S3_TIMEOUT_MS=900000
#NEXUS_MEDIA_PROXY_UPLOAD_RELAY_BUFFERED_RETRY_BYTES=33554432
#NEXUS_MEDIA_PROXY_UPLOAD_RELAY_BUFFERED_RETRY_TOTAL_BYTES=536870912
#NEXUS_MEDIA_PROXY_UPLOAD_RELAY_SPOOL_DIR=
#NEXUS_MEDIA_PROXY_UPLOAD_RELAY_SPOOL_CHUNK_BYTES=1048576
#NEXUS_MEDIA_PROXY_UPLOAD_RELAY_SPOOL_MAX_TOTAL_BYTES=8589934592

# app-proxy discovery refresh, index upstream and manifest scope.
#DISCOVERY_REFRESH_INTERVAL_MS=60000
#NEXUS_APP_PROXY_INDEX_UPSTREAM_URL=
#NEXUS_APP_PROXY_SAME_ORIGIN_HOSTS=
#NEXUS_APP_PROXY_MANIFEST_SCOPE_EXTENSIONS=
