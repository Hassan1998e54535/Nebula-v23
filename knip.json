{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"include": ["files", "exports", "types", "dependencies", "unlisted", "binaries", "catalog"],
	"ignoreExportsUsedInFile": true,
	"ignoreDependencies": ["@bufbuild/protoc-gen-es", "@tailwindcss/cli", "@types/events", "events", "tailwindcss"],
	"ignoreFiles": [
		"nexus_admin/src/styles/app.css",
		"nexus_admin/static/htmx.min.js",
		"nexus_app/src/features/voice/utils/camera-effects/models/selfie_segmentation_256x256.d.onnx.ts",
		"nexus_app/src/media/images/badges/bug-hunter.d.svg.ts",
		"nexus_app/src/media/images/badges/partner.d.svg.ts",
		"nexus_app/src/media/images/badges/plutonium.d.svg.ts",
		"nexus_app/src/media/images/badges/staff.d.svg.ts",
		"nexus_app/src/media/images/i-like-food.d.svg.ts"
	],
	"ignoreIssues": {
		"nexus_api/src/api/infrastructure/activity/Contract.generated.ts": ["exports", "types"],
		"nexus_app/src/features/platform/state/PersistentStorage.ts": ["exports"],
		"nexus_app/src/features/voice/utils/CodecCapabilityDetector.ts": ["exports"],
		"nexus_app/src/index.tsx": ["unlisted"]
	},
	"workspaces": {
		".": {
			"ignoreDependencies": ["vite"]
		},
		"nexus_api": {
			"ignoreDependencies": [
				"@elastic/elasticsearch",
				"@messageformat/core",
				"@messageformat/parser",
				"@vvo/tzdb",
				"emoji-regex",
				"ioredis",
				"maxmind",
				"pg",
				"pino",
				"undici",
				"validator"
			],
			"ignoreBinaries": ["ffmpeg", "ffprobe"]
		},
		"nexus_app": {
			"entry": [
				"lingui.config.js",
				"scripts/build-sw.mjs",
				"scripts/Generate*.ts",
				"src/features/platform/utils/BrowserAssertStrict.ts"
			]
		},
		"nexus_desktop": {
			"entry": [
				"src/main/Bootstrap.ts",
				"src/main/index.ts",
				"src/preload/index.ts",
				"src/preload/LegacyHarvestPreload.ts",
				"src/main/**/*.test.{ts,mjs}",
				"native/*/index.{js,d.ts}",
				"native/*/loader-diagnostics.cjs"
			],
			"project": ["src/**/*.{ts,tsx,mjs,js}", "scripts/**/*.mjs", "native/**/*.{js,mjs,cjs,d.ts}"],
			"ignoreBinaries": ["reg.exe", "update-desktop-database", "xdg-mime"],
			"ignoreDependencies": ["electron-builder"]
		},
		"nexus_docs": {
			"entry": ["scripts/*.ts", "src/**/*.astro"],
			"project": ["src/**/*.{ts,astro,mdx}", "scripts/**/*.ts"]
		},
		"packages/openapi": {
			"project": ["src/**/*.ts"]
		},
		"packages/schema": {
			"project": ["src/**/*.ts", "!src/gen/**"]
		},
		"packages/voice_engine_v2": {
			"entry": ["src/**/*.bench.ts"]
		}
	}
}
